{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HarujaeAgentPayload",
  "description": "하루재 Multi-Agent 간 공통 전달 데이터 구조 정의",
  "type": "object",
  "required": [
    "source_language",
    "target_language",
    "source_text"
  ],
  "properties": {
    "source_language": {
      "type": "string",
      "default": "English",
      "description": "원문 언어 (예: English, Japanese 등)"
    },
    "target_language": {
      "type": "string",
      "default": "Korean",
      "description": "목표 번역 언어 (기본값: Korean)"
    },
    "source_text": {
      "type": "string",
      "description": "사용자가 입력한 원본 텍스트"
    },
    "translated_text": {
      "type": "string",
      "description": "① Translation Agent가 생성한 1차 초벌 번역문"
    },
    "edited_text": {
      "type": "string",
      "description": "② Korean Editing Agent가 다듬은 윤문 텍스트"
    },
    "proofread_text": {
      "type": "string",
      "description": "④ Korean Proofreader가 완료한 최종 교정 텍스트"
    },
    "glossary": {
      "type": "array",
      "description": "적용할 용어집 항목 리스트",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" }
        }
      },
      "default": [
        { "source": "Artificial Intelligence", "target": "인공지능" },
        { "source": "Machine Learning", "target": "머신러닝" },
        { "source": "Deep Learning", "target": "딥러닝" },
        { "source": "Large Language Model", "target": "대규모 언어 모델" },
        { "source": "Agent", "target": "에이전트" },
        { "source": "Prompt", "target": "프롬프트" },
        { "source": "Inference", "target": "추론" },
        { "source": "Fine-tuning", "target": "파인튜닝" }
      ]
    },
    "style_guide": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string",
          "default": "professional"
        },
        "sentence_style": {
          "type": "string",
          "default": "합니다체"
        }
      }
    },
    "review": {
      "type": "object",
      "description": "③ Translation Reviewer의 감수 판정 및 오류 목록",
      "required": ["status", "critical", "major", "minor"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "REVISE"]
        },
        "revision_target": {
          "type": "string",
          "enum": ["NONE", "TRANSLATION_AGENT", "EDITING_AGENT"],
          "description": "REVISE 발생 시 재작업을 수행할 대상 Agent"
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "현재까지의 누적 재검토 횟수 (최대 3회)"
        },
        "critical": {
          "type": "array",
          "items": { "type": "string" }
        },
        "major": {
          "type": "array",
          "items": { "type": "string" }
        },
        "minor": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
